# ThreatForge Output — SIGNATURES
# CVE:       CVE-2026-16812
# Product:   velocloud_orchestrator
# Tags:      [KEV] [RCE] [RCE-KEV] [CRIT] [NEW]
# Score:     155
# Tier:      CRITICAL — ACT NOW
# Generated: 2026-07-30T07:40:09.561028Z
# Status:    OK
# ---

# Confidence: No public PoC known — pattern inferred from the CVE/advisory
# description only. The CISA KEV entry [3] and VulnCheck KEV [2] confirm active
# exploitation, and the advisory [5] characterises the vulnerability as OS command
# injection via remote access to privileged internal functionality (CVSS 10.0 [1]).
# However, the specific HTTP endpoint(s), parameter names, and payload structure
# used by attackers are not disclosed in any available source.
# Pattern targets HTTP requests to paths commonly associated with internal/admin
# API surfaces on VeloCloud Orchestrator (e.g. /portal/, /vco/ prefixes) combined
# with content patterns loosely indicative of OS command injection attempts
# (shell metacharacters in request bodies). This is a BROAD, LOW-FIDELITY heuristic
# that WILL produce false positives and may miss actual exploit traffic entirely.
# Do NOT deploy to block/drop mode without analyst validation.
# No packet-capture (PCAP) data source is available to this pipeline — this
# pattern is NOT verified against captured exploit traffic.
# DRAFT FOR ANALYST REVIEW — requires tuning against VCO traffic baselines
# before production deployment.

alert http $EXTERNAL_NET any -> $HOME_NET any (
  msg:"THREATFORGE CVE-2026-16812 Arista VeloCloud Orchestrator OS cmd injection attempt - privileged internal API access";
  flow:established,to_server;
  http.method; content:"POST";
  http.uri; content:"/vco"; nocase; pcre:"/\/(?:vco|portal|api|system|orchestrator)[\/\w\-]*/i";
  http.request_body; pcre:"/(?:[;&|`$]\s*\w+|\.\.\/|\/etc\/(?:passwd|shadow)|\/bin\/(?:sh|bash)|curl\s+|wget\s+|chmod\s+|nc\s+-)/i";
  threshold:type limit, track by_src, count 3, seconds 60;
  reference:cve,2026-16812;
  metadata:mitre_technique_id T1190, is_kev true, status experimental;
  classtype:attempted-admin; sid:9000100; rev:1; )

