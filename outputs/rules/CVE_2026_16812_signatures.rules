# ThreatForge Output — SIGNATURES
# CVE:       CVE-2026-16812
# Product:   velocloud_orchestrator
# Tags:      [KEV] [RCE] [RCE-KEV] [CRIT] [NEW]
# Score:     155
# Tier:      CRITICAL — ACT NOW
# Generated: 2026-07-30T09:20:16.960219Z
# Status:    OK
# ---

# Confidence: No public PoC known — pattern inferred from the CVE/advisory
# description only.
# The CISA KEV description [3] characterises this as OS command injection via
# remote access to privileged internal functionality on VeloCloud Orchestrator
# On-Prem (VCO). No specific URI path, parameter name, or payload structure
# is publicly confirmed. The pattern below targets HTTP requests to paths
# commonly associated with VCO internal/admin API surfaces combined with
# shell-metacharacter sequences typical of OS command injection; it is a
# HEURISTIC ONLY and will require tuning once vendor advisory detail or PoC
# material is available.
# No packet-capture (PCAP) data source is available to this pipeline — this
# pattern is NOT verified against captured exploit traffic.
# ANALYST REVIEW REQUIRED before deployment. High false-positive risk.
# This is a proposed draft for analyst review.

alert http $EXTERNAL_NET any -> $HOME_NET any (
  msg:"THREATFORGE CVE-2026-16812 Arista VeloCloud Orchestrator OS command injection attempt";
  flow:established,to_server;
  http.uri; content:"/vco/"; nocase;
  http.request_body;
  pcre:"/(?:%3B|%7C|%60|%24%28|\||;|`|\$\()\s*(?:id|whoami|curl|wget|bash|sh|cat|nc|python)/i";
  reference:cve,2026-16812;
  metadata:mitre_technique_id T1190, is_kev true, status experimental;
  classtype:attempted-admin; sid:9000004; rev:1; )

